# Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# Site Configuration
VITE_SITE_URL=https://yourdomain.com
VITE_SITE_NAME="Ttech SOLUTIONS"

# Firebase Configuration (Production)
VITE_FIREBASE_API_KEY=your-production-firebase-api-key
VITE_FIREBASE_PROJECT_ID=your-production-project-id
VITE_FIREBASE_APP_ID=your-production-app-id
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIRESTORE_DATABASE_ID=your-production-database-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-production-sender-id

# Gemini AI (Optional - for AI features)
GEMINI_API_KEY=your-gemini-api-key

# Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_FIREBASE=true
