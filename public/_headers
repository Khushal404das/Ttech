# Cache rules for static hosting (Cloudflare Pages / Netlify format).
# Hashed build files never change, so browsers may keep them for a year.
# HTML pages are not listed: the host's default makes browsers re-check them,
# so visitors always get the newest page and its matching script files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/projects/*
  Cache-Control: public, max-age=604800
