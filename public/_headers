# Response headers for Cloudflare static assets (Netlify-compatible format).

# Security headers on every page — browsers and Google treat the site as safer
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Hashed build files never change, so browsers may keep them for a year.
# HTML pages are not listed: the default makes browsers re-check them,
# so visitors always get the newest page and its matching script files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/projects/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=604800

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
