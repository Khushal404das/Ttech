{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "uid": "string",
        "email": "string",
        "displayName": "string",
        "photoURL": "string",
        "createdAt": "timestamp",
        "lastLoginAt": "timestamp"
      }
    },
    "ChatSession": {
      "collection": "users/{userId}/chat_history",
      "fields": {
        "title": "string",
        "role": "string",
        "model": "string",
        "messages": "array",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "SavedPlace": {
      "collection": "users/{userId}/saved_places",
      "fields": {
        "title": "string",
        "address": "string",
        "mapsUri": "string",
        "notes": "string",
        "rating": "number",
        "category": "string",
        "createdAt": "timestamp"
      }
    },
    "WorkspaceNote": {
      "collection": "users/{userId}/notes",
      "fields": {
        "title": "string",
        "content": "string",
        "category": "string",
        "tags": "array",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "ProjectInquiry": {
      "collection": "inquiries",
      "fields": {
        "clientName": "string",
        "email": "string",
        "phone": "string",
        "serviceType": "string",
        "budgetRange": "string",
        "timeline": "string",
        "projectDescription": "string",
        "preferredTech": "string",
        "status": "string",
        "createdAt": "timestamp"
      }
    }
  }
}
