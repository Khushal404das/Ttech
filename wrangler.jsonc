{
  // Cloudflare Workers deployment for ttechsolutionz.dev.
  // Having this file stops `wrangler deploy` from auto-configuring the
  // project (which rewired the build and made every deploy fail).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttech",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-23",
  "observability": { "enabled": true },

  "assets": {
    // Output of `npm run build`: pre-rendered pages, scripts, images
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown URLs get dist/404.html with a real 404 status — and missing
    // script files are no longer answered with the home page
    "not_found_handling": "404-page",
    // Only API calls run the Worker; everything else is served as a file
    "run_worker_first": ["/api/*"]
  },

  // Non-secret settings. Secrets (GEMINI_API_KEY, TELEGRAM_BOT_TOKEN,
  // RESEND_API_KEY …) are added in the Cloudflare dashboard, never here.
  "vars": {
    "INQUIRY_TO": "teatech.solutionz@gmail.com"
  }
}
